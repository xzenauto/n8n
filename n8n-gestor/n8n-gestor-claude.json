      ],
      "parameters": {
        "jsCode": "// Valida la petición que manda Claude y arma la URL de la API de n8n\nconst BASE = 'http://localhost:5678/api/v1'; // llamada interna: el dominio público no responde desde el propio servidor\nconst RECURSOS = ['workflows', 'executions', 'tags', 'credentials', 'variables', 'projects', 'users', 'audit', 'source-control'];\nconst b = $json.body || {};\nconst method = String(b.method || 'GET').toUpperCase();\nif (!['GET', 'POST', 'PUT', 'PATCH', 'DELETE'].includes(method)) {\n  return [{ json: { ok: false, error: 'método no permitido', method } }];\n}\nlet path = String(b.path || '');\nif (!path.startsWith('/')) path = '/' + path;\nif (path.includes('://') || path.includes('..')) {\n  return [{ json: { ok: false, error: 'path inválido', path } }];\n}\nconst recurso = path.split('/')[1].split('?')[0];\nif (!RECURSOS.includes(recurso)) {\n  return [{ json: { ok: false, error: 'recurso no permitido', recurso, permitidos: RECURSOS } }];\n}\n// Protección: este flujo no puede borrarse, desactivarse ni sobrescribirse a sí mismo\nconst propio = '/workflows/' + $workflow.id;\nif (method !== 'GET' && (path === propio || path.startsWith(propio + '/'))) {\n  return [{ json: { ok: false, error: 'no se permite modificar el propio gestor' } }];\n}\nconst qs = Object.entries(b.query || {})\n  .map(([k, v]) => encodeURIComponent(k) + '=' + encodeURIComponent(v)).join('&');\nreturn [{ json: {\n  ok: true,\n  method,\n  path,\n  url: BASE + path + (qs ? (path.includes('?') ? '&' : '?') + qs : ''),\n  body: b.body ?? null,\n} }];"
      }
    },
