    {
      "id": "eb3da818-f7e2-547f-913b-d9e5d6d2d626",
      "name": "Marcar visto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        0
      ],
      "parameters": {
        "jsCode": "// Recuerda lo ya revisado para no rescatarlo dos veces (si el envío falló, se reintenta en la siguiente vuelta).\nconst memoria = $getWorkflowStaticData('global');\nmemoria.vistos = memoria.vistos || {};\n// Llega por dos caminos: desde \"Enviar a Maripino\" (respuesta del webhook) o desde \"Rescatar\" (no se rescata).\nreturn $input.all().map((item, i) => {\n  const clave = item.json.clave ?? $('¿Rescatar?').itemMatching(i).json.clave;\n  if (clave && !item.json.error) memoria.vistos[clave] = Date.now();\n  return { json: { clave, enviado: !item.json.error && !item.json.clave } };\n});\n"
      }
    }
