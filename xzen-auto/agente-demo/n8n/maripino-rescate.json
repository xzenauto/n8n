    {
      "id": "60689cd3-c226-55a3-a6d8-2e097046f104",
      "name": "¿Rescatar?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "jsCode": "// No se rescata si ya le escribió una persona del equipo (sus mensajes llevan usuario; los de Maripino no,\n// y los automáticos de GHL vienen como \"workflow\"): esa conversación la lleva alguien a mano.\nconst cand = $('Candidatos').all();\nreturn $input.all().map((item, i) => {\n  let m = item.json.messages; m = (m && (m.messages || m)) || [];\n  if (!Array.isArray(m)) m = [];\n  const escribioPersona = m.some((x) => x.direction === 'outbound' && x.source !== 'workflow' && x.userId\n    && !String(x.messageType ?? '').startsWith('TYPE_ACTIVITY'));\n  return { json: { ...cand[i].json, rescatar: !escribioPersona, motivo: escribioPersona ? 'ya le escribió una persona del equipo' : 'sin respuesta' } };\n});\n"
      }
    },
    {
      "id": "cbf5fa94-98bf-57b5-8c31-3e180f041245",
      "name": "Rescatar",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "5f1de8a0-5363-561d-8620-bd3baff5ee40",
              "leftValue": "={{ $json.rescatar }}",
              "rightValue": "",
