    {
      "id": "3a5da5f8-1e74-46c8-9b70-0b60211cf718",
      "name": "Validar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        600
      ],
      "parameters": {
        "jsCode": "// Valida la petición que manda Claude y arma la URL final\nconst SUBCUENTAS = {\n  '7Nt4ISuJNkwzED4xLICK': 'Agencia Prueba',\n  'iYgqtO9TzgsM2X4hzyhj': 'Casa Alpa',\n  'h2uT4qSMLOLwbFIc0VdG': 'CSS Tzintzun',\n  '6YPwFzsOHxsCOyhudASD': 'INTEEC Centro Radiológico',\n  'pn5LM8sGbTIwlSFGC839': 'Perif. Paseo de la República 2286',\n  'DwMWdCw65Q94MRGh4CGa': 'Primero Viajo',\n  'oC2FNTV3Dc5yhLyrGvoy': 'RS Viajes Centro',\n  '4xUuPucjdj14sqVme6sO': 'Rs Viajes Hijar',\n  '2O4BBoTVOs95TgWbel6e': 'Rs Viajes Independencia',\n  'UIJiu5Wa9iPVzMpbaZcx': 'Rs Viajes Matriz',\n  'Jf5jBydZMO0fdMeo1d4O': 'Rs Viajes Periodismo',\n  '8SiKgyVuy9KVUIx1Y1RT': 'Xzen Auto'\n};\nconst b = $json.body || {};\nconst locationId = String(b.locationId || '');\nif (!SUBCUENTAS[locationId]) {\n  return [{ json: { ok: false, error: 'locationId no registrado en la pasarela', locationId } }];\n}\nlet path = String(b.path || '');\nif (!path.startsWith('/')) path = '/' + path;\nif (path.includes('://') || path.includes('..')) {\n  return [{ json: { ok: false, error: 'path inválido', path } }];\n}\nconst qs = Object.entries(b.query || {})\n  .map(([k, v]) => encodeURIComponent(k) + '=' + encodeURIComponent(v)).join('&');\nconst method = String(b.method || 'GET').toUpperCase();\nreturn [{ json: {\n  ok: true,\n  locationId,\n  subcuenta: SUBCUENTAS[locationId],\n  method,\n  url: 'https://services.leadconnectorhq.com' + path + (qs ? (path.includes('?') ? '&' : '?') + qs : ''),\n  version: b.version || '2021-07-28',\n  body: b.body ?? null,\n} }];"
      }
    },
