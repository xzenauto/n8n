    {
      "parameters": {
        "jsCode": "const raw = $('Vale - AI Agent').first().json.output ?? $('Vale - AI Agent').first().json.text ?? '';\nconst contact_id = $('Code - Construir Contexto').first().json.contact_id;\n\nconst cleaned = raw.replace(/```json\\s*|\\s*```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { mensajes: [raw || 'Disculpa, dame un segundo 🙏'], productos_a_mostrar: [] };\n}\n\nconst mensajes = Array.isArray(parsed.mensajes) ? parsed.mensajes.slice(0, 4) : [String(parsed.mensajes || '')];\n\nreturn mensajes.map(m => ({\n  json: {\n    mensaje: m,\n    contact_id: contact_id\n  }\n}));"
      },
      "id": "156574a4-5c1a-4ace-8139-ae2b552b5498",
      "name": "Code - Separar Mensajes",
