    {
      "parameters": {
        "jsCode": "const webhook = $('Webhook - Mensaje Entrante').first().json.body;\nconst prospecto = $('Supabase - Buscar Prospecto').first().json;\nconst opportunity = $input.first().json; // viene de Set - Opportunity Encontrada/Creada\n\nreturn [{\n  json: {\n    mensaje_cliente: webhook.message?.body || '',\n    contact_id: webhook.contact_id,\n    opportunity_id: opportunity?.opportunity_id || null,\n    pipeline_stage_id: opportunity?.pipeline_stage_id || null,\n    prospecto: {\n      nombre: prospecto.nombre || webhook.first_name || '',\n      categorias_interes: prospecto.categorias_interes || [],\n      presupuesto: prospecto.presupuesto || null,\n      estilo_color: prospecto.estilo_color || null,\n      ciudad: prospecto.ciudad || null,\n      codigo_postal: prospecto.codigo_postal || null,\n      origen_anuncio: prospecto.origen_anuncio || null,\n      etapa: prospecto.etapa || 'explorando'\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
