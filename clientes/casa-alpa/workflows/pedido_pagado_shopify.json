 "name": "Casa Alpa - Pedido pagado Shopify → GHL",
 "nodes": [
  {
   "parameters": {
    "content": "## Pedido pagado en Shopify → GHL\nConfigura en Shopify: **Configuración → Notificaciones → Webhooks → Crear webhook**, evento *Pago de pedido*, formato JSON, URL de este webhook (ruta secreta, no la compartas).\n\nSólo procesa pedidos ligados a un contacto de GHL: por el atributo `ghl_contact_id` del link de Vale o, si no viene, por el teléfono del pedido.",
    "height": 260,
    "width": 520
   },
   "name": "Nota",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    -60,
    -320
   ],
   "id": "b27486cb-3be2-4fcb-a273-44fee5846e8d"
  },
  {
   "parameters": {
    "httpMethod": "POST",
    "path": "casa-alpa-shopify-pedido-<TOKEN_SECRETO>",
    "options": {}
   },
   "name": "Webhook - Shopify Pedido Pagado",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    0
   ],
   "id": "8dae6bd2-4478-423f-8287-0c5257be5666",
   "webhookId": "3024765a-94d2-4c55-8a91-62504e936c2e"
  },
  {
   "parameters": {
    "jsCode": "const o = $json.body || {};\nconst attrs = Object.fromEntries((o.note_attributes || []).map(a => [a.name, a.value]));\nconst sa = o.shipping_address || {};\nconst tel = String(sa.phone || o.phone || o.customer?.phone || o.billing_address?.phone || '').replace(/\\D/g, '');\nlet e164 = null;\nif (tel.length === 10) e164 = '+52' + tel;\nelse if (tel.length === 12 && tel.startsWith('52')) e164 = '+' + tel;\nelse if (tel.length === 13 && tel.startsWith('521')) e164 = '+52' + tel.slice(3);\nelse if (tel.length > 10) e164 = '+' + tel;\nconst direccion = [sa.name, sa.address1, sa.address2, [sa.zip, sa.city].filter(Boolean).join(' '), sa.province, sa.country, sa.phone ? 'Tel. ' + sa.phone : null].filter(Boolean).join('\\n');\nconst items = (o.line_items || []).map(li => `${li.quantity}x ${li.title}${li.variant_title ? ' (' + li.variant_title + ')' : ''} — $${Number(li.price).toLocaleString('es-MX')}`);\nreturn [{ json: {\n  order_id: String(o.id || ''),\n  order_name: o.name || ('#' + (o.order_number || o.id)),\n  financial_status: o.financial_status,\n  total: Number(o.total_price || 0),\n  envio: Number(o.total_shipping_price_set?.shop_money?.amount || 0),\n  contact_id: attrs.ghl_contact_id || null,\n  link_id: attrs.vale_link_id || null,\n  telefono: e164,\n  email: o.email || o.customer?.email || null,\n  nombre: o.customer?.first_name || sa.first_name || '',\n  direccion: direccion || '(sin dirección de envío)',\n  items,\n  valido: !!o.id && ['paid', 'partially_paid'].includes(o.financial_status)\n} }];"
   },
