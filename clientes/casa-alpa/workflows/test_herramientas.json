  {
   "parameters": {
    "jsCode": "const first = $('Abrir Link').first().json;\nconst r = $input.first().json;\nconst html = String(r.data || r.body || '');\nconst buscar = ($('Webhook').first().json.body.buscar || []).map(String);\nconst low = html.toLowerCase();\nreturn [{ json: {\n  paso1_status: first.statusCode, paso1_redirige_a: (first.headers?.location || '').split('?')[0],\n  checkout_status: r.statusCode, checkout_redirige_a: r.headers?.location || null,\n  title: ((html.match(/<title>([^<]*)<\\/title>/i) || [])[1] || '').trim(),\n  contiene: Object.fromEntries(buscar.map(b => [b, low.includes(b.toLowerCase())])),\n  tamano_html: html.length\n} }];"
   },
