    "jsCode": "const r = $input.first().json;\nconst ps = r.products || [];\nreturn [{ json: { total: r.total ?? ps.length, productos: ps.slice(0, 50).map(p => ({ id: p._id || p.id, nombre: p.name, tipo: p.productType, disponible_en_store: p.availableInStore, creado: p.createdAt, origen: p.source || p.medias?.length })), error: r.message || null } }];"
