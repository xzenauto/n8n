    {
      "id": "3342547b-0bc5-4b94-8317-16a0c1aeb8c9",
      "name": "Validar lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst limpio = (s, n) => String(s ?? '').trim().slice(0, n);\nif (b.website) return [{ json: { ok: true, spam: true } }]; // trampa anti-bots\nconst email = limpio(b.email, 160).toLowerCase();\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) return [{ json: { ok: false, error: 'Correo inválido' } }];\nconst origen = b.origen === 'newsletter' ? 'newsletter' : 'contacto';\nreturn [{ json: {\n  ok: true,\n  origen,\n  mensaje: limpio(b.mensaje, 3000),\n  contacto: {\n    locationId: 'REEMPLAZAR_LOCATION_ID_GYRARTE',\n    name: limpio(b.nombre, 120) || undefined,\n    email,\n    phone: limpio(b.telefono, 30) || undefined,\n    source: 'gyrarte.com',\n    tags: ['gyrarte-' + origen],\n  },\n} }];"
      }
    },
    {
      "id": "5cc53751-13eb-423f-a1e9-007fe222ab74",
      "name": "¿Válido y no spam?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "5de331a3-ea15-46b6-8833-a28d2c113c53",
              "leftValue": "={{ $json.ok && !$json.spam }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
