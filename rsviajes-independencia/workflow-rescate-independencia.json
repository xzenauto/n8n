    {
      "parameters": {
        "jsCode": "// Conversaciones donde el último mensaje es del cliente (WhatsApp/Facebook/Instagram),\n// de hace más de 10 minutos y menos de 23 horas (aún se le puede contestar).\n// Cada mensaje se revisa una sola vez: se marca como visto en \"Marcar visto\" (si el envío falla, se reintenta en la siguiente vuelta).\nconst AG = {\"agencia\": \"independencia\", \"pipe\": \"5ZjBcNbDKm9Lm2fmN1dP\", \"etapasIA\": [\"0da76776-cd6a-41e8-8d2b-931240853b0f\", \"6c9ac950-c993-4deb-bab3-74115203b377\", \"65480ba0-0506-4559-856b-bb1868b967f9\"]};\nconst memoria = $getWorkflowStaticData('global');\nmemoria.vistos = memoria.vistos || {};\nconst ahora = Date.now();\nfor (const [k, t] of Object.entries(memoria.vistos)) if (ahora - t > 3 * 864e5) delete memoria.vistos[k];\nconst out = [];\nfor (const c of ($input.first().json.conversations || [])) {\n  const t = Number(c.lastMessageDate || 0);\n  const tipo = String(c.lastMessageType || '');\n  if (!/WHATSAPP|FACEBOOK|INSTAGRAM/.test(tipo)) continue;\n  if (ahora - t < 10 * 60e3 || ahora - t > 23 * 3600e3) continue;\n  const clave = `${c.id}:${t}`;\n  if (memoria.vistos[clave]) continue;\n  out.push({ json: { ...AG, clave, contactId: c.contactId, convId: c.id, nombre: c.fullName || c.contactName || '', telefono: c.phone || '',\n    medio: /WHATSAPP/.test(tipo) ? 'whatsapp' : /INSTAGRAM/.test(tipo) ? 'instagram' : 'facebook', tipo } });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "3a8b5437-f37d-42d3-8620-0d5a005cd555",
      "name": "Candidatos"
    },
    {
      "parameters": {
        "url": "=https://services.leadconnectorhq.com/opportunities/search?location_id=2O4BBoTVOs95TgWbel6e&contact_id={{ $json.contactId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
