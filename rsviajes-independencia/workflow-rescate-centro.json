    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Se rescata si no tiene oportunidad abierta en el pipeline, o si está en una etapa de la IA (Nuevo Lead / Explorando opciones).\n// No se toca si la lleva una vendedora: oportunidad en otra etapa, o ya le escribió una persona del equipo\n// (sus mensajes llevan usuario; los de la IA no, y los automáticos de GHL vienen como \"workflow\").\nconst cand = $('Candidatos').item.json;\nconst opps = ($('Oportunidades del contacto').item.json.opportunities || []).filter(o => o.pipelineId === cand.pipe && o.status === 'open');\nconst enIA = opps.some(o => cand.etapasIA.includes(o.pipelineStageId));\nconst mensajes = $json.messages?.messages || [];\nconst escribioPersona = mensajes.some(m => m.direction === 'outbound' && m.source !== 'workflow' && m.userId !== undefined && m.userId !== null\n  && !String(m.messageType || '').startsWith('TYPE_ACTIVITY'));\nlet rescatar = false, motivo = 'lo lleva una vendedora';\nif (!escribioPersona && opps.length === 0) { rescatar = true; motivo = 'sin oportunidad'; }\nelse if (!escribioPersona && enIA) { rescatar = true; motivo = 'sin respuesta en etapa IA'; }\nelse if (escribioPersona) motivo = 'ya le escribió una persona del equipo';\nconst [nombre1] = String(cand.nombre).split(' ');\nreturn { json: { rescatar, motivo,\n  payload: { contact_id: cand.contactId, first_name: nombre1 || '', full_name: cand.nombre, phone: cand.telefono,\n    message: { type: cand.medio === 'whatsapp' ? 19 : 11, body: '' }, contact: { attributionSource: { medium: cand.medio }, lastAttributionSource: { medium: cand.medio } }, rescate: true } } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "id": "3e3dfc59-bcc7-4e18-bc0b-25bf0f2cbe78",
      "name": "¿Rescatar?"
    },
