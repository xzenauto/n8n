    {
      "parameters": {
        "jsCode": "const fieldId = \"w6cFvbwT4aABlicTrr1v\";\n\nconst contacto = $input.first().json.contact;\n\nconst campoActual = (contacto.customFields || []).find(f => f.id === fieldId);\nconst valorActual = campoActual ? Number(campoActual.value) : 0;\n\nconst nuevoValor = (isNaN(valorActual) ? 0 : valorActual) + 1;\n\nreturn [{\n  json: {\n    contact_id: contacto.id,\n    nuevoValor,\n    customFields: [\n      { id: fieldId, fieldValue: nuevoValor }\n    ]\n  }\n}];"
      },
      "name": "Calcular nuevo valor",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
