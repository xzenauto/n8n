    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Recuerda los mensajes ya revisados para no rescatarlos dos veces.\n// Si el envío al agente falló, no se marca y se reintenta en la siguiente vuelta.\nif ($json.error) return { json: $json };\nconst memoria = $getWorkflowStaticData('global');\nmemoria.vistos = memoria.vistos || {};\nmemoria.vistos[$('Candidatos').item.json.clave] = Date.now();\nreturn { json: { marcado: $('Candidatos').item.json.clave } };"
      },
