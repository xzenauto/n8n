      ],
      "id": "bfac1de5-6175-4394-8c56-906a9b479ed6",
      "name": "Oportunidades del contacto",
      "credentials": {
        "httpHeaderAuth": {
          "id": "keLp0liZSLxAedNf",
          "name": "GHL-PIT-RsMatriz"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Se rescata si no tiene oportunidad abierta en el pipeline, o si está en una etapa de la IA (Nuevo Lead / Explorando opciones).\n// No se toca si la lleva una vendedora: oportunidad en otra etapa, o ya le escribió una persona del equipo\n// (sus mensajes llevan usuario; los de la IA no, y los automáticos de GHL vienen como \"workflow\").\nconst cand = $('Candidatos').item.json;\nconst opps = ($('Oportunidades del contacto').item.json.opportunities || []).filter(o => o.pipelineId === cand.pipe && o.status === 'open');\nconst enIA = opps.some(o => cand.etapasIA.includes(o.pipelineStageId));\nconst mensajes = $json.messages?.messages || [];\nconst escribioPersona = mensajes.some(m => m.direction === 'outbound' && m.source !== 'workflow' && m.userId !== undefined && m.userId !== null\n  && !String(m.messageType || '').startsWith('TYPE_ACTIVITY'));\nlet rescatar = false, motivo = 'lo lleva una vendedora';\nif (!escribioPersona && opps.length === 0) { rescatar = true; motivo = 'sin oportunidad'; }\nelse if (!escribioPersona && enIA) { rescatar = true; motivo = 'sin respuesta en etapa IA'; }\nelse if (escribioPersona) motivo = 'ya le escribió una persona del equipo';\nconst [nombre1] = String(cand.nombre).split(' ');\nreturn { json: { rescatar, motivo,\n  payload: { contact_id: cand.contactId, first_name: nombre1 || '', full_name: cand.nombre, phone: cand.telefono,\n    message: { type: cand.medio === 'whatsapp' ? 19 : 11, body: '' }, contact: { lastAttributionSource: { medium: cand.medio } }, rescate: true } } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "id": "b190f48d-b079-4de0-969a-121e4fbd0ce5",
      "name": "¿Rescatar?"
    },
    {
      "parameters": {
