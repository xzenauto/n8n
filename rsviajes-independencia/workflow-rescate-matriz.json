          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "f9d4a525-3c00-4fe0-8fb3-5608ee35cf56",
              "leftValue": "={{ $json.rescatar }}",
              "rightValue": "",
